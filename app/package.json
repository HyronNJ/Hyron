{
  "name": "hyron",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-workers.mjs",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run types && node scripts/prepare-workers.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write --ignore-path ../.prettierignore ..",
    "format:check": "prettier --check --ignore-path ../.prettierignore ..",
    "types": "mkdir -p .cloudflare && wrangler types .cloudflare/types.d.ts",
    "precheck": "npm run types"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "express": "^5.3.0",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "^4.152.0"
  },
  "type": "module"
}
